# ============================================================================
# EduPrep Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit real secrets, service-role keys, or AI API keys to Git.
# ============================================================================

# --- Public Client Variables (Safe for Browser with Supabase RLS enabled) ---
VITE_APP_NAME="EduPrep"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
VITE_AI_FUNCTION_URL="/api/ai-assistant"

# --- Server-Side / Edge Function Only Secrets (NEVER expose in browser) ---
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_API_KEY="your-server-side-ai-api-key"

# --- YouTube Data API v3 (Server-Side Only — NEVER expose in browser) ---
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"
